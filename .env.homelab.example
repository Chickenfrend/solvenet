# Copy to .env and set these values for your Docker host.
DOCKER_GID=999
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CONTEXT=4096
# Generate with openssl rand -hex 32; share only with site and Ollama worker.
SOLVENET_PROGRESS_TOKEN=
# Bind only to a trusted LAN/VPN interface for phone access.
SITE_BIND_IP=127.0.0.1
SITE_PORT=8081
# Optional hosted profile: external key FILE PATH only; never put a key here.
OPENAI_KEY_FILE=/var/lib/solvenet/secrets/openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROFILE=chat-json
OPENAI_CONTEXT=32768
OPENAI_CONTEXT_BYTES=32768
OPENAI_MAX_OUTPUT=16384
OPENAI_REASONING_EFFORT=
